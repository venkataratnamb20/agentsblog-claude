{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test*)",
      "Bash(npm ci)",
      "Bash(npx vitest *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull --ff-only*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr comment*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(npm run dev)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run typecheck)",
      "Bash(npm run coverage)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm run check:content)",
      "Bash(npm run secrets:scan)",
      "Bash(npm run changelog)",
      "Bash(npm run clean)",
      "Bash(git push -u origin HEAD)"
    ],
    "ask": [
      "Bash(gh pr merge*)",
      "Bash(gh release*)",
      "Bash(git tag*)",
      "Bash(git push origin v*)",
      "Bash(git push --tags*)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.husky/**)",
      "Edit(./scripts/scan-secrets.mjs)",
      "Bash(git config alias*)",
      "Edit(./.github/workflows/**)",
      "Edit(./.claude/settings.local.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.development)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * main)",
      "Bash(git push * develop)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Bash(npm publish*)",
      "Read(./**/secrets.json)",
      "Read(./**/secrets.yaml)",
      "Read(./**/secrets.yml)",
      "Read(./**/secrets.toml)",
      "Read(./**/credentials.json)",
      "Read(./**/credentials.yaml)",
      "Read(./**/credentials.yml)",
      "Bash(git push*--force*)",
      "Bash(git push*:main*)",
      "Bash(git push*:develop*)",
      "Bash(git push*:refs/*)",
      "Bash(git push*+*)",
      "Bash(git push*--delete*)",
      "Bash(git push*--mirror*)",
      "Bash(git commit*--no-verify*)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(git branch -D*)",
      "Bash(rm -r -f*)",
      "Bash(rm -fr*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(Get-Content *.env*)",
      "Read(./.env.test)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Read(./**/.npmrc)",
      "Read(./**/id_ed25519*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-gate.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-actions.mjs\""
          }
        ]
      }
    ]
  }
}
