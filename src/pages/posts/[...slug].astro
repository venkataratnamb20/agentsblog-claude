---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { SITE_NAME, includeDrafts, siteUrl } from '../../config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { filterVisible } from '../../lib/drafts';
import { articleJsonLd, breadcrumbJsonLd, canonicalUrl } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const entries = filterVisible(await getCollection('posts'), includeDrafts);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const site = siteUrl(Astro.site);
const path = `/posts/${entry.id}/`;
const url = canonicalUrl(site, path);
const jsonLd = [
  articleJsonLd({ ...entry.data, url, siteName: SITE_NAME }),
  breadcrumbJsonLd([
    { name: 'Home', url: canonicalUrl(site, '/') },
    { name: entry.data.title, url },
  ]),
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  type="article"
  jsonLd={jsonLd}
>
  <article>
    <h1>{entry.data.title}</h1>
    <time datetime={entry.data.date.toISOString()}>{entry.data.date.toDateString()}</time>
    <Content />
  </article>
</BaseLayout>
