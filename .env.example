# Copy to .env for local development: cp .env.example .env
# .env is gitignored and never committed. Values below are placeholders, not real secrets.
# Real values are created only when the hosting, newsletter and analytics choices are made,
# and then live in the provider's secret store (see docs/guidelines/secrets-and-access.md).

# Site behaviour (read by src/config.ts)
PREVIEW_DRAFTS=false
ALLOW_INDEXING=false

# Future integrations (placeholders; nothing reads these yet)
NEWSLETTER_API_KEY=replace-me
ANALYTICS_SITE_TOKEN=replace-me
HOSTING_API_TOKEN=replace-me
